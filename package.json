{
  "license": "AGPL-3.0-or-later",
  "name": "@sdkwork/models-catalog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "stop": "pnpm exec sdkwork-app stop",
    "dev": "pnpm dev:standalone",
    "build": "pnpm exec sdkwork-app build",
    "test": "pnpm exec sdkwork-app test",
    "check": "pnpm exec sdkwork-app check",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "models:validate": "node tools/validate-catalog.mjs",
    "models:align:capabilities": "node tools/align-model-capabilities.mjs",
    "models:align:pricing": "node tools/align-model-pricing.mjs",
    "models:migrate:pricing-v2": "node tools/migrate-pricing-v2.mjs --write",
    "models:check:pricing-v2": "node tools/migrate-pricing-v2.mjs",
    "models:check:vendor-architecture-doc": "node tools/generate-vendor-model-architecture-doc.mjs --check",
    "models:generate:vendor-architecture-doc": "node tools/generate-vendor-model-architecture-doc.mjs",
    "models:check:picker-catalog": "node tools/generate-mainstream-agent-model-catalog.mjs --check",
    "models:generate:picker-catalog": "node tools/generate-mainstream-agent-model-catalog.mjs",
    "models:sync": "node tools/sync-catalog.mjs",
    "models:seed:video-profiles": "node tools/seed-video-profiles.mjs",
    "models:sync:video-resolutions": "node tools/sync-video-profile-resolutions.mjs",
    "models:check:video-resolutions": "node tools/sync-video-profile-resolutions.mjs --check",
    "build:index": "node tools/build-index.mjs",
    "models:audit": "node tools/catalog-audit.mjs",
    "models:audit:pricing": "python tools/audit-pricing-consistency.py",
    "models:report:unreachable": "python tools/report-unreachable-pricing.py",
    "models:check:unreachable-report": "python tools/report-unreachable-pricing.py --check",
    "models:freshness": "node tools/freshness-report.mjs --max-age-policy catalog-freshness-policy.json",
    "models:evidence:stamp": "node tools/stamp-catalog-evidence.mjs --observed-at 2026-06-24T00:00:00Z --catalog-version 2026.06.24.2",
    "models:diff": "node tools/catalog-diff.mjs",
    "release:check": "node tools/release-catalog.mjs --check",
    "release:validate": "node tools/release-catalog.mjs --check",
    "sdk:check": "pnpm --filter @sdkwork/models run build && pnpm --filter @sdkwork/models run test",
    "api:materialize:models": "node tools/materialize-models-openapi.mjs",
    "api:materialize:openapi": "node tools/models_openapi_export.mjs",
    "sdk:generate": "node tools/models-sdk-generate.mjs",
    "sdk:build": "pnpm --filter @sdkwork/models-backend-sdk run build && pnpm --filter @sdkwork/models-app-sdk run build",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "api:check:route-manifest": "cargo test -p sdkwork-routes-models-catalog-backend-api --test route_manifest && cargo test -p sdkwork-routes-models-catalog-app-api --test route_manifest",
    "test:rust": "cargo test --workspace --offline",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_sdkwork-models_baseline.sql --module-id sdkwork-models --owner sdkwork-models-platform --prefixes ai_ --engines postgres",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "check:cors-standard": "node ../sdkwork-specs/tools/check-cors-standard.mjs --root .",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
    "_sdkwork:build": "node tools/build-index.mjs && pnpm --filter @sdkwork/models run build && pnpm --filter @sdkwork/models-pc run build",
    "_sdkwork:test": "pnpm --filter @sdkwork/models run test && pnpm --filter @sdkwork/models-pc run test && pnpm run test:rust",
    "_sdkwork:check": "pnpm run check:app-composition && node tools/migrate-pricing-v2.mjs && node tools/build-index.mjs --check && node tools/validate-catalog.mjs && node tools/freshness-report.mjs --max-age-policy catalog-freshness-policy.json --as-of-catalog-generated-at && node tools/catalog-audit.mjs && node tools/release-catalog.mjs --check && node tools/generate-mainstream-agent-model-catalog.mjs --check && node tools/generate-vendor-model-architecture-doc.mjs --check && node tools/models_openapi_export.mjs --check && node tools/materialize-models-openapi.mjs --check && node tests/contract/models-openapi-contract.test.mjs && node ../sdkwork-specs/tools/check-api-response-envelope.mjs --workspace .",
    "_sdkwork:verify": "pnpm run check && pnpm run test && pnpm run check:app-composition && pnpm check:cors-standard",
    "_sdkwork:clean": "node scripts/clean.mjs",
    "dev:standalone": "pnpm exec sdkwork-app dev --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --deployment-profile cloud",
    "release:validate:standalone": "pnpm exec sdkwork-app release:validate --deployment-profile standalone",
    "release:validate:cloud": "pnpm exec sdkwork-app release:validate --deployment-profile cloud",
    "db:postgres:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan --engine postgres",
    "db:postgres:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init --engine postgres",
    "build:pc:dev": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment dev",
    "build:pc:test": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment test",
    "build:pc:staging": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment staging",
    "build:pc:demo": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment demo",
    "build:pc:prod": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment prod",
    "check:browser-build-scripts": "node ../sdkwork-specs/tools/check-browser-build-scripts.mjs --root .",
    "build:pc:dev:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment dev --deployment-profile cloud",
    "build:pc:test:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment test --deployment-profile cloud",
    "build:pc:staging:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment staging --deployment-profile cloud",
    "build:pc:demo:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment demo --deployment-profile cloud",
    "build:pc:prod:cloud": "node ../sdkwork-specs/tools/build-browser-client.mjs --root . --architecture pc --environment prod --deployment-profile cloud"
  },
  "dependencies": {
    "@sdkwork/utils": "workspace:*",
    "@sdkwork/app-topology": "workspace:*"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@sdkwork/cloudroutes-pc-commons",
        "@sdkwork/cloudrouter-pc-commons",
        "lucide-react",
        "react",
        "react-dom",
        "react-i18next"
      ]
    },
    "overrides": {
      "@sdkwork/sdk-common": "workspace:*"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
