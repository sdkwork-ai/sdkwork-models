{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.cloud/schemas/sdkwork-models/model.schema.json",
  "title": "Sdkwork Model",
  "type": "object",
  "required": [
    "schemaVersion",
    "modelId",
    "displayName",
    "vendorCode",
    "regionCode",
    "catalogKey",
    "familyCode",
    "primaryCapability",
    "inputModalities",
    "outputModalities",
    "apiFormat",
    "lifecycle",
    "releaseStage",
    "shelfState",
    "routingState",
    "supportsStreaming",
    "supportsTools",
    "supportsJsonSchema",
    "usageScopes",
    "codingVisible",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "vendorCode": {
      "type": "string"
    },
    "regionCode": {
      "type": "string"
    },
    "catalogKey": {
      "type": "string"
    },
    "familyCode": {
      "type": "string"
    },
    "primaryCapability": {
      "$ref": "#/$defs/capability"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "inputModalities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modality"
      }
    },
    "outputModalities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modality"
      }
    },
    "apiFormat": {
      "description": "The standard API protocol this model conforms to. References a protocolCode defined in schemas/protocol.schema.json. Each value is named after the originating vendor that defines the protocol standard.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "lifecycle": {
      "enum": [
        "active",
        "preview",
        "deprecated",
        "catalog_only",
        "retired"
      ]
    },
    "releaseStage": {
      "enum": [
        "active",
        "preview",
        "deprecated",
        "retired"
      ]
    },
    "shelfState": {
      "enum": [
        "listed",
        "hidden",
        "archived"
      ]
    },
    "routingState": {
      "enum": [
        "enabled",
        "disabled",
        "catalog_only"
      ]
    },
    "supportsStreaming": {
      "description": "Whether the model supports streamed (SSE/chunked) response delivery. Aligns with OpenAI stream=true and Gemini streamGenerateContent.",
      "type": "boolean",
      "default": false
    },
    "supportsTools": {
      "description": "Whether the model supports tool/function calling (OpenAI tools, Anthropic tools, Gemini function calling).",
      "type": "boolean",
      "default": false
    },
    "supportsJsonSchema": {
      "description": "Whether the model supports structured output constrained by JSON Schema (OpenAI response_format json_schema, Gemini responseSchema).",
      "type": "boolean",
      "default": false
    },
    "usageScopes": {
      "description": "Product usage scopes where the model can be applied, e.g. coding (code IDE/agent surfaces). References the usageScope enum in $defs.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/usageScope"
      },
      "default": []
    },
    "codingVisible": {
      "description": "Whether the model is shown in code IDE surfaces. Defaults to true; non-chat models (embedding, media, speech) are aligned to false.",
      "type": "boolean",
      "default": true
    },
    "source": {
      "$ref": "#/$defs/sourceEvidence"
    }
  },
  "$defs": {
    "modelFeature": {
      "description": "Protocol interaction feature derived from supports* flags. Use SDK modelSupportsFeature() for runtime checks.",
      "enum": [
        "streaming",
        "tool_call",
        "structured_output"
      ]
    },
    "capability": {
      "enum": [
        "chat",
        "reasoning",
        "code",
        "embedding",
        "image",
        "audio",
        "music",
        "sfx",
        "video",
        "streaming",
        "rerank",
        "tool",
        "decision"
      ]
    },
    "usageScope": {
      "description": "Product usage surface where a model can be selected. coding covers code IDE and coding-agent surfaces.",
      "enum": [
        "coding",
        "chat",
        "agent"
      ]
    },
    "modality": {
      "enum": [
        "text",
        "image",
        "audio",
        "music",
        "video",
        "embedding",
        "rerank",
        "tool"
      ]
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "sourceUrl",
        "observedAt"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string"
        },
        "observedAt": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
