{
  "name": "@sdkwork/models-app-sdk",
  "version": "0.1.6",
  "private": false,
  "description": "Composed TypeScript consumer SDK for sdkwork-models app catalog API.",
  "type": "module",
  "main": "./generated/server-openapi/dist/index.cjs",
  "module": "./generated/server-openapi/dist/index.js",
  "types": "./generated/server-openapi/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/server-openapi/dist/index.d.ts",
      "import": "./generated/server-openapi/dist/index.js",
      "require": "./generated/server-openapi/dist/index.cjs"
    }
  },
  "scripts": {
    "build": "pnpm --dir generated/server-openapi run build",
    "typecheck": "tsc --noEmit -p generated/server-openapi/tsconfig.json"
  },
  "dependencies": {
    "@sdkwork/sdk-common": "^1.0.8",
    "@sdkwork/utils": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rollup": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "sdkwork": {
    "workspace": "sdkwork-models-app-sdk",
    "sdkFamily": "sdkwork-models-app-sdk",
    "domain": "intelligence",
    "capability": "catalog-app-sdk",
    "status": "ready"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "dist",
    "composed",
    "generated/server-openapi/dist",
    "generated/server-openapi/src",
    "generated/server-openapi/sdkwork-sdk.json",
    "generated/server-openapi/README.md",
    "generated/server-openapi/LICENSE",
    "generated/domains/server-openapi/dist",
    "generated/domains/server-openapi/src",
    "generated/domains/server-openapi/sdkwork-sdk.json",
    "generated/domains/server-openapi/README.md",
    "generated/domains/server-openapi/LICENSE",
    "README.md",
    "LICENSE"
  ]
}
