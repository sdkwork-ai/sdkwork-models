{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "@sdkwork/models-catalog",
    "displayName": "SDKWork Models Catalog",
    "version": "0.1.0",
    "type": "composed-product-module",
    "root": ".",
    "domain": "intelligence",
    "declaredDomain": "intelligence",
    "capability": "catalog",
    "status": "ready",
    "languages": [
      "javascript",
      "typescript",
      "python",
      "java",
      "rust",
      "dart"
    ],
    "generated": false,
    "private": true,
    "manifests": [
      "package.json",
      "pnpm-workspace.yaml",
      "Cargo.toml",
      "agent.app.config.json",
      "database/database.manifest.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "COMPONENT_SPEC.md",
      "path": "../sdkwork-specs/COMPONENT_SPEC.md",
      "purpose": "Local component specs directory and manifest rules."
    },
    {
      "file": "CODE_STYLE_SPEC.md",
      "path": "../sdkwork-specs/CODE_STYLE_SPEC.md",
      "purpose": "Authored source structure and generated code boundaries."
    },
    {
      "file": "DEPENDENCY_MANAGEMENT_SPEC.md",
      "path": "../sdkwork-specs/DEPENDENCY_MANAGEMENT_SPEC.md",
      "purpose": "Native build-tool dependency management and cross-repository source paths."
    },
    {
      "file": "DOCUMENTATION_SPEC.md",
      "path": "../sdkwork-specs/DOCUMENTATION_SPEC.md",
      "purpose": "Module README, examples, ADR, changelog, and runbook rules."
    },
    {
      "file": "DOMAIN_SPEC.md",
      "path": "../sdkwork-specs/DOMAIN_SPEC.md",
      "purpose": "Canonical domain ownership and naming."
    },
    {
      "file": "GOVERNANCE_SPEC.md",
      "path": "../sdkwork-specs/GOVERNANCE_SPEC.md",
      "purpose": "Standard ownership, exception, compatibility, and migration rules."
    },
    {
      "file": "MODULE_SPEC.md",
      "path": "../sdkwork-specs/MODULE_SPEC.md",
      "purpose": "Reusable package contract and dependency direction."
    },
    {
      "file": "NAMING_SPEC.md",
      "path": "../sdkwork-specs/NAMING_SPEC.md",
      "purpose": "Canonical SDKWork naming rules."
    },
    {
      "file": "PNPM_SCRIPT_SPEC.md",
      "path": "../sdkwork-specs/PNPM_SCRIPT_SPEC.md",
      "purpose": "Uniform public package.json script names."
    },
    {
      "file": "README.md",
      "path": "../sdkwork-specs/README.md",
      "purpose": "SDKWork root standards entrypoint."
    },
    {
      "file": "RELEASE_SPEC.md",
      "path": "../sdkwork-specs/RELEASE_SPEC.md",
      "purpose": "Catalog release versioning and release evidence."
    },
    {
      "file": "SDK_SPEC.md",
      "path": "../sdkwork-specs/SDK_SPEC.md",
      "purpose": "SDK generation and SDK integration rules."
    },
    {
      "file": "SDKWORK_WORKSPACE_SPEC.md",
      "path": "../sdkwork-specs/SDKWORK_WORKSPACE_SPEC.md",
      "purpose": "Repository root directory dictionary and .sdkwork workspace metadata."
    },
    {
      "file": "TEST_SPEC.md",
      "path": "../sdkwork-specs/TEST_SPEC.md",
      "purpose": "Contract, SDK, and catalog verification rules."
    },
    {
      "file": "TYPESCRIPT_CODE_SPEC.md",
      "path": "../sdkwork-specs/TYPESCRIPT_CODE_SPEC.md",
      "purpose": "TypeScript and Node package rules."
    }
  ],
  "contracts": {
    "publicExports": [
      "@sdkwork/models",
      "@sdkwork/models-pc",
      "@sdkwork/models-pc-core",
      "@sdkwork/models-pc-catalog"
    ],
    "runtimeEntrypoints": [
      "tools/build-index.mjs",
      "tools/validate-catalog.mjs",
      "tools/catalog-audit.mjs",
      "tools/release-catalog.mjs"
    ],
    "sdkClients": [
      "sdkwork-models-app-sdk",
      "sdkwork-models-backend-sdk",
      "@sdkwork/models-app-sdk",
      "@sdkwork/models-backend-sdk"
    ],
    "events": [],
    "configKeys": [
      "SDKWORK_MODELS_CATALOG_ROOT"
    ],
    "routeManifest": "crates/sdkwork-routes-catalog-backend-api/src/routes.rs"
  },
  "integration": {
    "authority": "Root SDKWork specs remain authoritative. Local specs may extend but must not contradict them.",
    "dependencyPolicy": "Consumers integrate through generated @sdkwork/models-{app,backend}-sdk families, catalog JSON artifacts, or documented catalog tools. Composed hosts mount route crates locally and must declare sdkwork-models SDK surfaces in specs/dependency-api-surfaces.json.",
    "sdkPolicy": "Generated SDK clients are injected through service/runtime boundaries; reusable UI must not create raw HTTP clients or manual auth headers.",
    "languagePolicy": "Language-specific packages follow their native manifest and build tools while preserving the same component contract."
  },
  "verification": {
    "commands": [
      "pnpm run check",
      "pnpm run verify",
      "pnpm run api:check:route-manifest",
      "pnpm run db:validate",
      "node ../sdkwork-specs/tools/check-api-response-envelope.mjs --workspace .",
      "cargo test --workspace --offline"
    ]
  },
  "metadata": {
    "managedBy": "sdkwork-models maintainers",
    "standardVersion": "2026-06-21"
  }
}
